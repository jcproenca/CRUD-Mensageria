{
  "info": {
    "name": "API 1 Pessoa - Spring Boot",
    "description": "Collection Postman para CRUD de Pessoas Físicas e Jurídicas com autenticação HTTP Basic.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "admin123",
      "type": "string"
    },
    {
      "key": "fisicaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "juridicaId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Pessoas Físicas",
      "item": [
        {
          "name": "Listar todas as pessoas físicas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/fisicas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fisicas"
              ]
            }
          }
        },
        {
          "name": "Buscar pessoa física por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/fisicas/{{fisicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fisicas",
                "{{fisicaId}}"
              ]
            }
          }
        },
        {
          "name": "Criar pessoa física",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Oliveira\",\n  \"genero\": \"Feminino\",\n  \"idade\": 25,\n  \"cpf\": \"98765432100\",\n  \"endereco\": {\n    \"rua\": \"Rua das Acácias\",\n    \"numero\": \"456\",\n    \"complemento\": \"Casa 2\",\n    \"bairro\": \"Jardim\",\n    \"cidade\": \"Rio de Janeiro\",\n    \"estado\": \"RJ\",\n    \"cep\": \"20040-020\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fisicas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fisicas"
              ]
            }
          }
        },
        {
          "name": "Atualizar pessoa física",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Oliveira Santos\",\n  \"genero\": \"Feminino\",\n  \"idade\": 26,\n  \"cpf\": \"98765432100\",\n  \"endereco\": {\n    \"rua\": \"Rua das Acácias\",\n    \"numero\": \"456\",\n    \"complemento\": \"Casa 3\",\n    \"bairro\": \"Jardim\",\n    \"cidade\": \"Rio de Janeiro\",\n    \"estado\": \"RJ\",\n    \"cep\": \"20040-020\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fisicas/{{fisicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fisicas",
                "{{fisicaId}}"
              ]
            }
          }
        },
        {
          "name": "Deletar pessoa física",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/fisicas/{{fisicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "fisicas",
                "{{fisicaId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Pessoas Jurídicas",
      "item": [
        {
          "name": "Listar todas as pessoas jurídicas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/juridicas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "juridicas"
              ]
            }
          }
        },
        {
          "name": "Buscar pessoa jurídica por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/juridicas/{{juridicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "juridicas",
                "{{juridicaId}}"
              ]
            }
          }
        },
        {
          "name": "Criar pessoa jurídica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tech Soluções S.A.\",\n  \"genero\": \"Empresa\",\n  \"idade\": 10,\n  \"cnpj\": \"98765432000188\",\n  \"endereco\": {\n    \"rua\": \"Alameda Santos\",\n    \"numero\": \"200\",\n    \"complemento\": \"Andar 5\",\n    \"bairro\": \"Cerqueira César\",\n    \"cidade\": \"São Paulo\",\n    \"estado\": \"SP\",\n    \"cep\": \"01419-000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/juridicas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "juridicas"
              ]
            }
          }
        },
        {
          "name": "Atualizar pessoa jurídica",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tech Soluções LTDA\",\n  \"genero\": \"Empresa\",\n  \"idade\": 12,\n  \"cnpj\": \"98765432000188\",\n  \"endereco\": {\n    \"rua\": \"Alameda Santos\",\n    \"numero\": \"200\",\n    \"complemento\": \"Andar 6\",\n    \"bairro\": \"Cerqueira César\",\n    \"cidade\": \"São Paulo\",\n    \"estado\": \"SP\",\n    \"cep\": \"01419-000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/juridicas/{{juridicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "juridicas",
                "{{juridicaId}}"
              ]
            }
          }
        },
        {
          "name": "Deletar pessoa jurídica",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/juridicas/{{juridicaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "juridicas",
                "{{juridicaId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
